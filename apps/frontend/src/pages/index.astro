---
import Base from '../layouts/Base.astro';
---
<Base title="Welcome">
  <section class="space-y-3">
    <h1>Hereya Fullstack Serverless Template</h1>
    <p class="text-neutral-600">
      A starter that runs equally well as a static marketing site (with public
      forms like a waiting-list) or as a fullstack app with closed-signup
      authentication, role-based access, and per-user data.
    </p>
  </section>

  <section class="space-y-3">
    <h2>Try it</h2>
    <ul class="space-y-2 text-sm">
      <li class="rounded-md border border-neutral-200 bg-white p-3">
        <a href="/subscribe" class="font-medium">/subscribe</a>
        <span class="ml-1 text-neutral-600">
          — public newsletter form, no auth required. Demonstrates the
          static-only path.
        </span>
      </li>
      <li class="rounded-md border border-neutral-200 bg-white p-3">
        <a href="/login" class="font-medium">/login</a>
        <span class="ml-1 text-neutral-600">
          — passwordless email-OTP sign-in. The first visitor becomes admin;
          everyone else must be pre-added by an admin.
        </span>
      </li>
      <li class="rounded-md border border-neutral-200 bg-white p-3">
        <a href="/dashboard" class="font-medium">/dashboard</a>
        <span class="ml-1 text-neutral-600">
          — auth-gated notes UI (members + admin).
        </span>
      </li>
      <li class="rounded-md border border-neutral-200 bg-white p-3">
        <a href="/admin/users" class="font-medium">/admin/users</a>
        <span class="ml-1 text-neutral-600">
          — admin-only user management (list / add / suspend).
        </span>
      </li>
      <li class="rounded-md border border-neutral-200 bg-white p-3">
        <a href="/about" class="font-medium">/about</a>
        <span class="ml-1 text-neutral-600">— public static page.</span>
      </li>
    </ul>
  </section>
</Base>
