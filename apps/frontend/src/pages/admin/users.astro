---
import AdminBase from '../../layouts/AdminBase.astro';
import { HyAdminTabs } from '../../components/AdminTabs';
import { HyAdminUsers } from '../../components/AdminUsers';
import { HyPasskeyBanner } from '../../components/PasskeyBanner';
---
<AdminBase title="Admin · Users">
  <div class="space-y-1">
    <h1>Users</h1>
    <p class="text-sm text-neutral-500">
      Admin · authorize who can sign in
    </p>
  </div>
  <HyAdminTabs current="users" client:only="lit" />
  <HyPasskeyBanner client:only="lit" />
  <HyAdminUsers client:only="lit" />
</AdminBase>
