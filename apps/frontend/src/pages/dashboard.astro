---
import Base from '../layouts/Base.astro';
import { HyDashboard } from '../components/Dashboard';
---
<Base title="Dashboard">
  {/*
    client:only="lit" — see Base.astro for the rationale (Lit SSR uses
    Declarative Shadow DOM, which blocks the document-level Tailwind
    stylesheet). The skeleton renders as soon as the Lit bundle parses
    and the element constructs — measured under 100 ms on a warm cache.
  */}
  <HyDashboard client:only="lit" />
</Base>
