---
import { HyAuthNav } from '../components/AuthNav';
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Hereya Fullstack Serverless' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    {/*
      client:only="lit" instead of client:load. @lit-labs/ssr always
      emits Declarative Shadow DOM (<template shadowrootmode="open">),
      which traps the rendered markup inside a shadow root the global
      Tailwind stylesheet can't reach. With client:only, SSR is skipped
      entirely; on client mount the LitElement's createRenderRoot()
      override returns `this`, rendering into Light DOM where Tailwind
      utilities apply normally. The brief delay before the nav appears
      is bounded by the ~20 KB Lit bundle parse time.
    */}
    <HyAuthNav client:only="lit" />
    <main class="mx-auto max-w-3xl px-4 py-8 space-y-6">
      <slot />
    </main>
  </body>
</html>
